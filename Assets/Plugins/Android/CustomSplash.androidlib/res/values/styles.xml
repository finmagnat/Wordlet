<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="CustomLaunchTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <!-- Старые версии Android (до Android 12) -->
        <item name="android:windowBackground">@color/splash_bg_color</item>

        <!-- Поддержка Android 12+ (убирает вылеты и задает цвет фона) -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_bg_color</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_logo</item>
    </style>
</resources>