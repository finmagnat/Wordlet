  - m_Id: 6208095938772992
    m_Localized: "\u0412\u0456\u0442\u0430\u0454\u043C\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 6208253044817920
    m_Localized: "\u0412\u0438 \u0432\u0438\u0433\u0440\u0430\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6208435203440640
    m_Localized: "\u0412\u0438\u0433\u0440\u0430\u0432 \u043E\u043F\u043E\u043D\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6208603676049408
    m_Localized: "\u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0449\u0435
      \u0440\u0430\u0437! \u0423\u0441\u043F\u0456\u0445 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C
      \u0456\u0437 \u0434\u043E\u0441\u0432\u0456\u0434\u043E\u043C ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 6208766385684480
    m_Localized: "\u041D\u0456\u0447\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6208915790987264
    m_Localized: "\u041C\u0430\u0439\u0436\u0435 \u0432\u0438\u0439\u0448\u043B\u043E!
      \u0426\u0435 \u043F\u0456\u0432 \u043A\u0440\u043E\u043A\u0443 \u0434\u043E
      \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0438! \u0414\u0430\u0432\u0430\u0439
      \u0449\u0435 \u0440\u0430\u0437\u043E\u043A ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 6209112730337280
    m_Localized: "\u041D\u043E\u0432\u0435 \u0441\u043B\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6209284000546816
    m_Localized: "\u0422\u0430\u043A\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430
      \u043D\u0435\u043C\u0430\u0454 \u0443 \u0441\u043B\u043E\u0432\u043D\u0438\u043A\u0443.
      \n\n\u0414\u043E\u0434\u0430\u0442\u0438 \u0439\u043E\u0433\u043E \u0434\u043E
      \u0441\u043B\u043E\u0432\u043D\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 6209513227649024
    m_Localized: "\u0420\u0410\u0414\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 6209654886072320
    m_Localized: "\u041D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
      \u043E\u0434\u043D\u0443 \u043B\u0456\u0442\u0435\u0440\u0443 \u043D\u0430
      \u043F\u043E\u043B\u0456 \u043F\u043E\u0440\u044F\u0434 \u0437 \u0456\u043D\u0448\u043E\u044E
      \u043B\u0456\u0442\u0435\u0440\u043E\u044E \u043D\u0430 \u043F\u043E\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 6209811929202688
    m_Localized: "\u041D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E, \u0449\u043E\u0431
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u200B\u200B\u043B\u0456\u0442\u0435\u0440\u0430
      \u0431\u0443\u043B\u0430 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u0434\u043E
      \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6210033103241216
    m_Localized: "\u041D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u0432\u0438\u0434\u0456\u043B\u0438\u0442\u0438
      \u043B\u0456\u0442\u0435\u0440\u0438, \u0449\u043E\u0431 \u0432\u0438\u0439\u0448\u043B\u043E
      \u0441\u043B\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 11300732908486656
    m_Localized: "\u0413\u0420\u0410 \u041D\u0415 \u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 11300996570824704
    m_Localized: "\u0412\u0438 \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u0435
      \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0443 \u0433\u0440\u0443.\r\n\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438
      \u043F\u043E\u0442\u043E\u0447\u043D\u0443 \u0433\u0440\u0443, \u0449\u043E\u0431
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0443 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 11301129366683648
    m_Localized: "\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 11301326352171008
    m_Localized: "\u0412\u0438\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12342219381293056
    m_Localized: "\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u0456\u0442\u044C \u043B\u0456\u0442\u0435\u0440\u0443"
