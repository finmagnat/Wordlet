  m_SharedData: {fileID: 11400000, guid: 50d4f8a5b29ff6c4d81e6cf9c447f908, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 166060244992
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u0433\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 502774775808
    m_Localized: "* \u0423 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C\u0443
      \u0440\u044F\u0434\u043A\u0443 \u043F\u043E\u043B\u044F \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0454\u0442\u044C\u0441\u044F
      \u0434\u043E\u0432\u0456\u043B\u044C\u043D\u0435 \u0441\u043B\u043E\u0432\u043E
      \u0456\u0437 \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0432\u043D\u0438\u043A\u0430.\n* \u0413\u0440\u0430\u0432\u0446\u044E
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u0435\u0440\u0435\u0442\u044F\u0433\u043D\u0443\u0442\u0438
      \u043E\u0434\u043D\u0443 \u043B\u0456\u0442\u0435\u0440\u0443 \u0437 \u0430\u043B\u0444\u0430\u0432\u0456\u0442\u0443
      \u0456 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438 \u0457\u0457
      \u0432 \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u0439 \u043E\u0441\u0435\u0440\u0435\u0434\u043E\u043A
      \u043F\u043E\u043B\u044F \u043F\u043E\u0440\u044F\u0434 \u0437 \u0456\u043D\u0448\u0438\u043C\u0438
      \u043B\u0456\u0442\u0435\u0440\u0430\u043C\u0438 \u0442\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C, \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u043E\u0432\u0435 \u0441\u043B\u043E\u0432\u043E.\n* \u041F\u043E\u0442\u0456\u043C
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043F\u043E\u0441\u043B\u0456\u0434\u043E\u0432\u043D\u043E
      \u0432\u0438\u0434\u0456\u043B\u0438\u0442\u0438 \u043B\u0456\u0442\u0435\u0440\u0438
      \u043D\u0430 \u043F\u043E\u043B\u0456, \u0449\u043E\u0431 \u0437\u0456\u0431\u0440\u0430\u0442\u0438
      \u0446\u0435 \u0441\u043B\u043E\u0432\u043E \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438
      \u043A\u043D\u043E\u043F\u043A\u0443 \u201C\u041F\u043E\u0445\u043E\u0434\u0438\u0442\u044C\u201D.\n*
      \u0421\u043B\u043E\u0432\u0430 \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C
      \u043F\u043E\u0432\u0442\u043E\u0440\u044E\u0432\u0430\u0442\u0438\u0441\u044F
      \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u043E\u0434\u043D\u0456\u0454\u0457
      \u0433\u0440\u0438.\n* \u0423 \u0441\u043B\u043E\u0432\u0456 \u043D\u0435 \u043C\u043E\u0436\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u043E\u0434\u043D\u0430 \u0456 \u0442\u0430 \u0436 \u043B\u0456\u0442\u0435\u0440\u0430
      \u043D\u0430 \u0456\u0433\u0440\u043E\u0432\u043E\u043C\u0443 \u043F\u043E\u043B\u0456
      \u0434\u0432\u0456\u0447\u0456.\n* \u0421\u043B\u043E\u0432\u043E \u043C\u043E\u0436\u0435
      \u0447\u0438\u0442\u0430\u0442\u0438\u0441\u044F \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443, \u043A\u0440\u0456\u043C
      \u0434\u0456\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E.\n*
      \u0417\u0430 \u043A\u043E\u0436\u043D\u0443 \u0431\u0443\u043A\u0432\u0443
      \u0441\u043A\u043B\u0430\u0434\u0435\u043D\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430
      \u043D\u0430\u0440\u0430\u0445\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u043E\u0434\u043D\u0435 \u043E\u0447\u043A\u043E.\n* \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u0438 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0445\u0456\u0434 \u0437\u0430 \u0432\u0456\u0434\u0432\u0435\u0434\u0435\u043D\u0438\u0439
      \u0447\u0430\u0441.\n* \u042F\u043A\u0449\u043E \u0433\u0440\u0430\u0432\u0435\u0446\u044C
      \u043D\u0435 \u0432\u0441\u0442\u0438\u0433\u0430\u0454 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0445\u0456\u0434, \u0439\u043E\u043C\u0443 \u0437\u0430\u0440\u0430\u0445\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u0435\u0440\u0435\u043F\u0443\u0441\u0442\u043A\u0430.\n* \u042F\u043A\u0449\u043E
      \u0443 \u0433\u0440\u0430\u0432\u0446\u044F \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u043F\u0443\u0441\u0442\u043E\u043A \u0434\u043E\u0441\u044F\u0433\u043B\u0430
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0443, \u0439\u043E\u043C\u0443
      \u0437\u0430\u0440\u0430\u0445\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
      \u043F\u043E\u0440\u0430\u0437\u043A\u0430 \u0456 \u0433\u0440\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      (\u043F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043D\u0430\u0431\u0440\u0430\u043D\u0438\u0445 \u043E\u0447\u043E\u043A \u043D\u0435
      \u0432\u0440\u0430\u0445\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F).\n*
      \u0422\u0430\u043A\u043E\u0436 \u0433\u0440\u0430 \u0432\u0432\u0430\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E\u044E, \u043A\u043E\u043B\u0438
      \u0432\u0441\u0456 \u043E\u0441\u0435\u0440\u0435\u0434\u043A\u0438 \u043F\u043E\u043B\u044F
      \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0456 \u043B\u0456\u0442\u0435\u0440\u0430\u043C\u0438.\n*
      \u0412\u0438\u0433\u0440\u0430\u0454 \u0433\u0440\u0430\u0432\u0435\u0446\u044C,
      \u044F\u043A\u0438\u0439 \u043D\u0430\u0431\u0440\u0430\u0432 \u0431\u0456\u043B\u044C\u0448\u0443
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043E\u0447\u043E\u043A.\n*
      \u042F\u043A\u0449\u043E \u0443 \u0433\u0440\u0430\u0432\u0446\u0456\u0432
      \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u0430 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u043E\u0447\u043E\u043A, \u043E\u0433\u043E\u043B\u043E\u0448\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0456\u0447\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 20447734677504
    m_Localized: "\u0417\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F \u0442\u0430
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 20937088319488
    m_Localized: "<b>\u042F\u043A \u0432\u0438\u0434\u0430\u043B\u0438\u0442\u0438
      \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u043D\u044F \u0437 \u043B\u0456\u0442\u0435\u0440
      \u043D\u0430 \u043F\u043E\u043B\u0456?</b>\r\n - \u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438
      \u043A\u043D\u043E\u043F\u043A\u0443 \u201C\u0417\u043C\u0438\u0442\u0438\u201D.
      \u041F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
      \u200B\u200B\u043B\u0456\u0442\u0435\u0440\u0430 \u043D\u0435 \u0432\u0438\u0434\u0430\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u0437 \u043F\u043E\u043B\u044F.\r\n\r\n<b>\u042F\u043A \u0432\u0438\u0434\u0430\u043B\u0438\u0442\u0438
      \u043B\u0456\u0442\u0435\u0440\u0443, \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0443
      \u043D\u0430 \u043F\u043E\u043B\u0456?</b>\r\n - \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u043A\u043D\u043E\u043F\u043A\u0443 \u201C\u0421\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438\u201D.
      \u041F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u0438\u0434\u0430\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u0437 \u043F\u043E\u043B\u044F
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u200B\u200B\u043B\u0456\u0442\u0435\u0440\u0430,
      \u0430\u043B\u0435 \u0439 \u0437\u0430\u0431\u0438\u0440\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u043D\u044F (\u044F\u043A\u0449\u043E
      \u043B\u0456\u0442\u0435\u0440\u0438 \u0431\u0443\u043B\u0438 \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u0456).\r\n\r\n<b>\u042F\u043A
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0433\u0440\u0443 \u043D\u0430
      \u043F\u0430\u0443\u0437\u0443?</b>\r\n - \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u043A\u043D\u043E\u043F\u043A\u0443 \u201C\u041F\u0430\u0443\u0437\u0430\u201D.
      \u041F\u0440\u0438 \u0446\u044C\u043E\u043C\u0443 \u0442\u0430\u0439\u043C\u0435\u0440
      \u0445\u043E\u0434\u0443 \u0437\u0443\u043F\u0438\u043D\u044F\u0454\u0442\u044C\u0441\u044F,
      \u0430 \u043B\u0456\u0442\u0435\u0440\u0438 \u043D\u0430 \u043F\u043E\u043B\u0456
      \u0445\u043E\u0432\u0430\u044E\u0442\u044C\u0441\u044F \u043F\u0456\u0434 \u0447\u0430\u0441
      \u043F\u0430\u0443\u0437\u0438.\r\n - \u0429\u043E\u0431 \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0438
      \u0433\u0440\u0443, \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u043D\u043E\u0432\u0443
      \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
      \u201C\u041F\u0430\u0443\u0437\u0430\u201D.\r\n\r\n<b>\u042F\u043A \u0432\u0438\u0439\u0442\u0438
      \u0437 \u0433\u0440\u0438, \u044F\u043A\u0449\u043E \u0457\u0457 \u0449\u0435
      \u043D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E?</b>\r\n
      - \u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
      \u201C\u0414\u043E\u0434\u043E\u043C\u0443\u201D.\r\n - \u042F\u043A\u0449\u043E
      \u0446\u0435 \u0440\u0435\u0436\u0438\u043C \u0433\u0440\u0438 \u0437 \u0406\u0406,
      \u0437'\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u0432\u0456\u043A\u043D\u043E
      \u0437 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0454\u044E \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
      \u043F\u043E\u0442\u043E\u0447\u043D\u0443 \u0433\u0440\u0443.\r\n -- \u0406
      \u044F\u043A\u0449\u043E \u0433\u0440\u0430 \u0431\u0443\u043B\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0430,
      \u0442\u043E \u043F\u0456\u0437\u043D\u0456\u0448\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0431\u0443\u0434\u0435 \u0457\u0457 \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438
      \u0442\u0430 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0433\u0440\u0430\u0442\u0438
      \u0437\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E\u0433\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442\u0443.\r\n\r\n<b>\u042F\u043A \u044F \u043C\u043E\u0436\u0443
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0431\u0443\u0441\u0442\u0435\u0440 \"\u0411\u0443\u043A\u043E\u0432\u043A\u0430\"?</b>\r\n
      - \u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438 \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0456
      \u0456\u043A\u043E\u043D\u043A\u0443 \u0437 \u0431\u0443\u0441\u0442\u0435\u0440\u043E\u043C,
      \u044F\u043A\u0449\u043E \u0432\u043E\u043D\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430.\r\n
      - \u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F
      \u0406\u0406-\u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0438 \u0434\u043B\u044F
      \u043F\u043E\u0448\u0443\u043A\u0443 \u0441\u043B\u043E\u0432\u0430 (\u043D\u0430\u0439\u0434\u043E\u0432\u0448\u043E\u0433\u043E
      \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0446\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E),
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u043F\u043E\u043B\u0456
      \u043B\u0456\u0442\u0435\u0440\u0438 \u0442\u0430 \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u043D\u044F
      \u0446\u044C\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u043D\u0430
      \u043F\u043E\u043B\u0456.\r\n - \u042F\u043A\u0449\u043E \u0406\u0406 \u043D\u0435
      \u0437\u043C\u0456\u0433 \u0437\u043D\u0430\u0439\u0442\u0438 \u0441\u043B\u043E\u0432\u043E,
      \u0431\u0443\u0441\u0442\u0435\u0440 \u0431\u0443\u0434\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u043E
      \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440 \u0433\u0440\u0430\u0432\u0446\u044F.\r\n\r\n<b>\u042F\u043A
      \u044F \u043C\u043E\u0436\u0443 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0431\u0443\u0441\u0442\u0435\u0440 \"\u0423\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043D\u044F\"?</b>\r\n
      - \u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438 \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0456
      \u0456\u043A\u043E\u043D\u043A\u0443 \u0437 \u0431\u0443\u0441\u0442\u0435\u0440\u043E\u043C,
      \u044F\u043A\u0449\u043E \u0432\u043E\u043D\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430.\r\n
      - \u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457
      \u0437\u0443\u043F\u0438\u043D\u044F\u0454 \u0442\u0430\u0439\u043C\u0435\u0440
      \u043D\u0430 \u044F\u043A\u0438\u0439\u0441\u044C \u0447\u0430\u0441 (\u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
      30 \u0441\u0435\u043A\u0443\u043D\u0434), \u0449\u043E \u0434\u0430\u0454 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0439
      \u0447\u0430\u0441 \u0433\u0440\u0430\u0432\u0446\u0435\u0432\u0456.\r\n\r\n<b>\u042F\u043A
      \u044F \u043C\u043E\u0436\u0443 \u043F\u0440\u0438\u0434\u0431\u0430\u0442\u0438
      \u0431\u0443\u0441\u0442\u0435\u0440\u0438?</b>\r\n - \u0411\u0443\u0441\u0442\u0435\u0440
      \u0437\u0430\u0432\u0436\u0434\u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
      \u0434\u043B\u044F \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456
      \u0433\u0440\u0438 \u0437\u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u0456
      \u0433\u0440\u043E\u0448\u0456.\r\n - \u0422\u0430\u043A\u043E\u0436 \u0431\u0443\u0441\u0442\u0435\u0440\u0438
      \u043C\u043E\u0436\u043D\u0430 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0437\u0430 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434 \u0440\u0435\u043A\u043B\u0430\u043C\u0438."
